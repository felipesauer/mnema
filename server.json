{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.felipesauer/mnema",
  "title": "mnema: decision records for AI coding agents",
  "description": "Signed, append-only decision records for AI coding agents, over MCP. Verify them offline.",
  "repository": {
    "url": "https://github.com/felipesauer/mnema",
    "source": "github",
    "subfolder": "packages/code"
  },
  "version": "0.1.4",
  "websiteUrl": "https://felipesauer.github.io/mnema/",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mnema/code",
      "version": "0.1.4",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
