        "{\"event\":{\"after\":[\"c58b167d1aaf7568f944e8ddab657b4c2e957cb6d34e9d7cd3eae80e5d8b2bbf\"],\"at\":\"2026-11-03T20:42:02.199Z\",\"kind\":\"identity.founded\",\"payload\":{\"foundingFp\":\"9fd32446b0bef91b06d36c7bf0fc3cbd3dd84c25410bd95b9ca8d9fcbe8219bd\"},\"signerFp\":\"9fd32446b0bef91b06d36c7bf0fc3cbd3dd84c25410bd95b9ca8d9fcbe8219bd\",\"subject\":\"mnid:f42528915994a942b9f033e0f0c2b5c920e2f735bd58151a9009bd2b5e62e207\",\"v\":1,\"who\":\"mnid:f42528915994a942b9f033e0f0c2b5c920e2f735bd58151a9009bd2b5e62e207\"},\"link\":{\"hash\":\"aa5a9d65bd74cfc57a7bff02630a3c80429502fc265d1ccb2f6278035534bdf1\",\"prev\":null,\"seq\":0,\"tail\":\"9fd32446b0bef91b06d36c7bf0fc3cbd3dd84c25410bd95b9ca8d9fcbe8219bd-8dbc70893e27aecdffe399928cf5f1bf\"}}",
        "{\"event\":{\"at\":\"2026-11-03T20:42:02.345Z\",\"kind\":\"run.started\",\"payload\":{\"agent\":\"claude-code\"},\"signerFp\":\"9fd32446b0bef91b06d36c7bf0fc3cbd3dd84c25410bd95b9ca8d9fcbe8219bd\",\"subject\":\"01a1a325-be49-7000-91fe-46edb622336d\",\"v\":1,\"which\":\"claude-code\",\"who\":\"mnid:f42528915994a942b9f033e0f0c2b5c920e2f735bd58151a9009bd2b5e62e207\"},\"link\":{\"hash\":\"aa94c7fedf222bc584b224e6f79952413450461872ef8a1d1c5dd3ca426d5fef\",\"prev\":\"aa5a9d65bd74cfc57a7bff02630a3c80429502fc265d1ccb2f6278035534bdf1\",\"seq\":1,\"tail\":\"9fd32446b0bef91b06d36c7bf0fc3cbd3dd84c25410bd95b9ca8d9fcbe8219bd-8dbc70893e27aecdffe399928cf5f1bf\"}}",
        "{\"event\":{\"at\":\"2026-11-03T20:42:02.378Z\",\"kind\":\"channel.served\",\"payload\":{},\"run\":\"01a1a325-be49-7000-91fe-46edb622336d\",\"signerFp\":\"9fd32446b0bef91b06d36c7bf0fc3cbd3dd84c25410bd95b9ca8d9fcbe8219bd\",\"subject\":\"edit-rules-push\",\"v\":1,\"which\":\"claude-code\",\"who\":\"mnid:f42528915994a942b9f033e0f0c2b5c920e2f735bd58151a9009bd2b5e62e207\"},\"link\":{\"hash\":\"0cd733d682b6693670324e30d0fca10be92379a31519b0ef83739bda6f91e335\",\"prev\":\"aa94c7fedf222bc584b224e6f79952413450461872ef8a1d1c5dd3ca426d5fef\",\"seq\":2,\"tail\":\"9fd32446b0bef91b06d36c7bf0fc3cbd3dd84c25410bd95b9ca8d9fcbe8219bd-8dbc70893e27aecdffe399928cf5f1bf\"}}",
        "{\"event\":{\"at\":\"2026-11-03T20:42:32.697Z\",\"kind\":\"decision.recorded\",\"payload\":{\"adr\":\"ADR-2\",\"alternatives\":\"`/^export\\\\s+/`: rejected, `\\\\s` differs between JS (Unicode) and PHP (ASCII), a parity gap. Strip any `export` token even without whitespace (`startsWith('export')`): rejected, it would turn the legitimate keys `export` and `exported` into wrong keys. Change only the JS package or only PHP: rejected by ADR-1, the gap is the defect. Also accept `export` with quoting or `declare -x`: not asked for, left out to keep the parser plain.\",\"rationale\":\"`export KEY=value` lines read as KEY=value, as if the prefix were absent. The prefix is `export` followed by one or more spaces or tabs (`/^export[ \\\\t]+/`), removed after the blank/comment check and the trim, so `# export X=1` stays a comment, and `export=1` and `exported=2` remain ordinary keys. A bare `export FLAG` has no `=` and is skipped like any other line without one. The same regex and order are used in packages/js and packages/php, as ADR-1 requires, with equivalent tests in both. `[ \\\\t]` is chosen over `\\\\s` because JS `\\\\s` matches Unicode whitespace while PHP's non-/u `\\\\s` matches only ASCII, which would make the two packages disagree on exotic whitespace.\",\"title\":\"EnvAccessor strips a leading `export` only when a space or tab follows it, in both packages\"},\"run\":\"01a1a325-be49-7000-91fe-46edb622336d\",\"signerFp\":\"9fd32446b0bef91b06d36c7bf0fc3cbd3dd84c25410bd95b9ca8d9fcbe8219bd\",\"subject\":\"01a1a326-3561-7000-b765-57e80d0d1e58\",\"v\":1,\"which\":\"claude-code\",\"who\":\"mnid:f42528915994a942b9f033e0f0c2b5c920e2f735bd58151a9009bd2b5e62e207\"},\"link\":{\"hash\":\"5d6b0a4d10ee1e82adb567a01b57647a7baa46e55bf1b3244ebeb9706fa14150\",\"prev\":\"0cd733d682b6693670324e30d0fca10be92379a31519b0ef83739bda6f91e335\",\"seq\":3,\"tail\":\"9fd32446b0bef91b06d36c7bf0fc3cbd3dd84c25410bd95b9ca8d9fcbe8219bd-8dbc70893e27aecdffe399928cf5f1bf\"}}",
