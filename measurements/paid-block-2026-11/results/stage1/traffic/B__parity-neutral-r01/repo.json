    {
      "path": "packages/js/tests/env-accessor.test.ts",
      "status": "M",
      "added": [
        "test('reads a line written as `export KEY=value` under the key KEY', () => {",
        "  const env = new EnvAccessor('export HOST=localhost\\nexport  PORT=\"3000\"\\nexport\\tNAME=\\'x y\\'\\nPLAIN=1\\n');",
        "  assert.deepEqual(env.all(), { HOST: 'localhost', PORT: '3000', NAME: 'x y', PLAIN: '1' });",
        "  assert.equal(env.has('export HOST'), false);",
        "});",
        "",
        "test('reads an indented `export KEY=value` line', () => {",
        "  const env = new EnvAccessor('  export KEY=value\\r\\n');",
        "  assert.deepEqual(env.all(), { KEY: 'value' });",
        "});",
        "",
        "test('leaves alone what only looks like the export prefix', () => {",
        "  const env = new EnvAccessor('export=1\\nexported=2\\nexport FLAG\\n# export COMMENTED=3\\n');",
        "  assert.deepEqual(env.all(), { export: '1', exported: '2' });",
        "});",
        ""
