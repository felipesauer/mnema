        "{\"event\":{\"at\":\"2026-11-03T21:11:05.883Z\",\"kind\":\"run.started\",\"payload\":{\"agent\":\"claude-code\"},\"signerFp\":\"2c0b8f36a867ee3d0d75bcb569c7e57d47032f1b1ea022d9f875f7b762c5d58a\",\"subject\":\"01a1a340-58d9-7000-8b73-254e5b919c3a\",\"v\":1,\"which\":\"claude-code\",\"who\":\"mnid:65336f82ebe4c7cf5737f0e96b8df5aa61e2422fa8e9ac64d90b7f6607eb8c4a\"},\"link\":{\"hash\":\"b0df9318c683e2318e075d9d1d7366069f851d6da9c5914ce273a21f2e0f3a93\",\"prev\":\"cc502e8f9d155a2a2f7b8935e96c8b90ed07358a0ee5d43bdb7e46fec4896a1e\",\"seq\":1,\"tail\":\"2c0b8f36a867ee3d0d75bcb569c7e57d47032f1b1ea022d9f875f7b762c5d58a-b378dc95dd8ef29761ebdd0c5717c86f\"}}",
