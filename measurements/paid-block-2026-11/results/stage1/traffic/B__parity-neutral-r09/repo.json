    {
      "path": "packages/js/tests/env-accessor.test.ts",
      "status": "M",
      "added": [
        "test('reads `export KEY=value` lines as KEY=value', () => {",
        "  const env = new EnvAccessor('export HOST=localhost\\nexport   PORT=\"3000\"\\nexport\\tNAME=x\\n');",
        "  assert.deepEqual(env.all(), { HOST: 'localhost', PORT: '3000', NAME: 'x' });",
        "  assert.equal(env.has('export HOST'), false);",
        "});",
        "",
        "test('treats the export prefix as if it were not there', () => {",
        "  const env = new EnvAccessor('export # a comment\\nexport #HIDDEN=1\\nexport NOVALUE\\nexport =x\\nexport\\nexport=kept\\nexportKEY=y\\n');",
        "  assert.deepEqual(env.all(), { export: 'kept', exportKEY: 'y' });",
        "});",
        ""
