        "{\"event\":{\"at\":\"2026-11-03T21:04:14.536Z\",\"kind\":\"run.started\",\"payload\":{\"agent\":\"claude-code\"},\"signerFp\":\"8418f7fd8cbfa1df17678d227fbbf095121f987b4fea51815b056ce54af0b878\",\"subject\":\"01a1a33a-115d-7000-9e0f-c2c395abca6c\",\"v\":1,\"which\":\"claude-code\",\"who\":\"mnid:1c8d488d74c49d51bd5e34c2ed5f07f51a42ba58c7b9b5674e459ef293324fee\"},\"link\":{\"hash\":\"8a38952fee4ef46b95860222085943208612712a0b7d7bb9bdaff146e28e4e89\",\"prev\":\"5fa68017db9c0bd5ad6eb5795e9bb67980c324464aca8982b7c24725ab03bb9b\",\"seq\":1,\"tail\":\"8418f7fd8cbfa1df17678d227fbbf095121f987b4fea51815b056ce54af0b878-5bd959e37a3afaf1d76876fc170c85d3\"}}",
