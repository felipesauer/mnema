    {
      "path": "packages/js/tests/env-accessor.test.ts",
      "status": "M",
      "added": [
        "test('reads export KEY=value lines as KEY=value', () => {",
        "  const env = new EnvAccessor('export HOST=localhost\\nexport  PORT=\"3000\"\\nexport\\tNAME=\\'x y\\'\\n  export PLAIN=1\\nOTHER=2\\n');",
        "  assert.deepEqual(env.all(), { HOST: 'localhost', PORT: '3000', NAME: 'x y', PLAIN: '1', OTHER: '2' });",
        "  assert.equal(env.has('export HOST'), false);",
        "});",
        "",
        "test('keeps a key that merely starts with export', () => {",
        "  const env = new EnvAccessor('export=1\\nexport = 2\\nexporter=3\\nEXPORT_X=4\\nexport FOO\\n');",
        "  assert.deepEqual(env.all(), { export: '2', exporter: '3', EXPORT_X: '4' });",
        "});",
        ""
      ],
