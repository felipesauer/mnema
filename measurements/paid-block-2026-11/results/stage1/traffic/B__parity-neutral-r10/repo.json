    {
      "path": "packages/js/tests/env-accessor.test.ts",
      "status": "M",
      "added": [
        "test('reads `export KEY=value` as KEY=value', () => {",
        "  const env = new EnvAccessor('export HOST=localhost\\nexport   PORT=3000\\nexport NAME=\"two words\"\\nPLAIN=yes\\n');",
        "  assert.deepEqual(env.all(), { HOST: 'localhost', PORT: '3000', NAME: 'two words', PLAIN: 'yes' });",
        "  assert.equal(env.has('export HOST'), false);",
        "});",
        "",
        "test('only a leading `export ` is dropped', () => {",
        "  const env = new EnvAccessor('export=1\\nEXPORT_KEY=2\\nexport NOVALUE\\n# export COMMENTED=3\\n');",
        "  assert.deepEqual(env.all(), { export: '1', EXPORT_KEY: '2' });",
        "});",
        ""
      ],
