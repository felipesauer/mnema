    {
      "path": "packages/js/tests/env-accessor.test.ts",
      "status": "M",
      "added": [
        "test('reads export KEY=value as KEY=value', () => {",
        "  const env = new EnvAccessor('export HOST=localhost\\n  export   PORT=3000\\nexport\\tNAME=\"a b\"\\n');",
        "  assert.deepEqual(env.all(), { HOST: 'localhost', PORT: '3000', NAME: 'a b' });",
        "  assert.equal(env.has('export HOST'), false);",
        "});",
        "",
        "test('leaves lines that only look like an export alone', () => {",
        "  const env = new EnvAccessor('export=1\\nexportKEY=2\\nexport = 3\\nexport KEY\\n# export COMMENTED=4\\n');",
        "  assert.deepEqual(env.all(), { export: '3', exportKEY: '2' });",
        "});",
