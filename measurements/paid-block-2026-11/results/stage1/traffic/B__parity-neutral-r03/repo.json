        "{\"event\":{\"at\":\"2026-11-03T20:51:47.481Z\",\"kind\":\"run.started\",\"payload\":{\"agent\":\"claude-code\"},\"signerFp\":\"7d41a9a200e26800891009841e0ccee4c910ba560ca328be3ed171473f62a3f5\",\"subject\":\"01a1a32e-ac64-7000-94de-560791e80024\",\"v\":1,\"which\":\"claude-code\",\"who\":\"mnid:e5c436c24662dec000a3440683bc839da04a0ad6460e04fb589b3c0de48daa71\"},\"link\":{\"hash\":\"87296d34ac24abafed038ef3bb75dc327d5e5fb410b2a6de97c6eb6d75f1d725\",\"prev\":\"0d4a448412290db54c08ce04c0153a179faf6e163710e87396bd0d3a00797cbe\",\"seq\":1,\"tail\":\"7d41a9a200e26800891009841e0ccee4c910ba560ca328be3ed171473f62a3f5-a6c3133e212f29a79b4772a65620d780\"}}",
