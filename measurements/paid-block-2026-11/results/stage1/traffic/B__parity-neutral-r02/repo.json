    {
      "path": "packages/js/tests/env-accessor.test.ts",
      "status": "M",
      "added": [
        "test('reads `export KEY=value` as KEY=value', () => {",
        "  const env = new EnvAccessor('export HOST=localhost\\nexport  PORT = 3000\\nexport\\tNAME=\"two words\"\\n  export PLAIN=1\\nTOKEN=abc\\n');",
        "  assert.deepEqual(env.all(), { HOST: 'localhost', PORT: '3000', NAME: 'two words', PLAIN: '1', TOKEN: 'abc' });",
        "  assert.equal(env.has('export HOST'), false);",
        "});",
        "",
        "test('only a leading `export` followed by a space or tab is a prefix', () => {",
        "  const env = new EnvAccessor('exportHOST=a\\nexport=b\\nexport\\nexport NOEQUALS\\nexport =c\\nexport # note=d\\n# export HIDDEN=e\\nX=export Y=f\\n');",
        "  assert.deepEqual(env.all(), { exportHOST: 'a', export: 'b', X: 'export Y=f' });",
        "});",
        ""
      ],
      "removed": [],
