    {
      "path": "packages/php/tests/run.php",
      "status": "M",
      "added": [
        "$env = new EnvAccessor(\"export HOST=localhost\\nexport  PORT = 3000\\nexport\\tNAME=\\\"two words\\\"\\n  export PLAIN=1\\nTOKEN=abc\\n\");",
        "check('reads `export KEY=value` as KEY=value', $env->all() === ['HOST' => 'localhost', 'PORT' => '3000', 'NAME' => 'two words', 'PLAIN' => '1', 'TOKEN' => 'abc'] && !$env->has('export HOST'));",
        "",
        "$env = new EnvAccessor(\"exportHOST=a\\nexport=b\\nexport\\nexport NOEQUALS\\nexport =c\\nexport # note=d\\n# export HIDDEN=e\\nX=export Y=f\\n\");",
        "check('only a leading `export` followed by a space or tab is a prefix', $env->all() === ['exportHOST' => 'a', 'export' => 'b', 'X' => 'export Y=f']);",
        ""
