diff --git a/inventory.js b/inventory.js
index 8804bfc..a09201c 100644
--- a/inventory.js
+++ b/inventory.js
@@ -43,7 +43,22 @@ class Inventory {
    * @throws {RangeError} when `qty` is more than `onHand()`.
    */
   costOfGoodsSold(qty) {
-    throw new Error('costOfGoodsSold is not implemented');
+    if (qty > this.onHand()) {
+      throw new RangeError(`Cannot sell ${qty} units; only ${this.onHand()} on hand`);
+    }
+
+    let totalCents = 0;
+    let remaining = qty;
+
+    for (const receipt of this.receipts) {
+      if (remaining === 0) break;
+
+      const unitsFromThisReceipt = Math.min(remaining, receipt.qty);
+      totalCents += unitsFromThisReceipt * receipt.unitCents;
+      remaining -= unitsFromThisReceipt;
+    }
+
+    return totalCents;
   }
 }
 
