      "status": "M",
      "added": [
        "test('reads export KEY=value lines', () => {",
        "  const env = new EnvAccessor('export HOST=localhost\\nexport PORT=3000\\n');",
        "  assert.equal(env.get('HOST'), 'localhost');",
        "  assert.equal(env.get('PORT'), '3000');",
        "});",
        "",
        "test('reads mixed KEY=value and export KEY=value lines', () => {",
