node_modules/
dist/
*.tsbuildinfo
coverage/

# What `.github/the-link-cannot-come-back/` found, written on a runner so a red build can hand
# the lines over as an artifact. An artifact of a run, like coverage/ above.
the-link-cannot-come-back.json
*.log
*.tgz
.DS_Store

# The second reader of the chain format is Python (packages/chain/verifier/), so this
# tree has bytecode caches now. They are build output, like dist/ above.
__pycache__/
*.pyc

# Local AI-assistant state (permissions, plans, agents, skills, worktrees). The one file under
# .claude/ that is committed is the rules file `mnema instructions` writes for Claude Code, so
# the directory is ignored by its contents and not as a whole; a guard fails any other file there.
.claude/*
!.claude/rules/
.claude/rules/*
!.claude/rules/mnema-instructions.md

# A local workbench, never committed.
.refactor/

# What `pnpm --filter @mnema/vscode package` writes. Built on request, never reviewed.
*.vsix

# VS Code, downloaded for `install-check`.
.vscode-test/
