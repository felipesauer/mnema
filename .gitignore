node_modules/
dist/
*.tsbuildinfo
coverage/

# What a run of the suite leaves for `.github/why-it-went-red/` to read. An artifact of a
# run, like coverage/ above: rewritten by every run and never reviewed.
why-it-went-red.json

# The before-listing `.github/what-the-suite-left-behind/` takes with the suite stopped. A fact
# about one machine at one instant: committed, every sweep after the first reads a stranger's /tmp.
what-the-suite-left-behind.json

# What `.github/the-link-cannot-come-back/` found, written on a runner so a red build can hand
# the lines over as an artifact. An artifact of a run, like the two above.
the-link-cannot-come-back.json
*.log
*.tgz
.DS_Store

# The second reader of the chain format is Python (packages/chain/verifier/), so this
# tree has bytecode caches now. They are build output, like dist/ above.
__pycache__/
*.pyc

# Local AI-assistant state (permissions, plans).
.claude/

# A local workbench, never committed.
.refactor/

# What `pnpm --filter @mnema/vscode package` writes. Built on request, never reviewed.
*.vsix

# VS Code, downloaded for `install-check`.
.vscode-test/
