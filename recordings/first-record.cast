[0.031603, "o", "\u001b[2J\u001b[H\u001b[2m# an empty repository, and nothing on the network\u001b[0m\r\n"]
[0.83306, "o", "\u001b[1m$\u001b[0m m"]
[0.859546, "o", "n"]
[0.885878, "o", "e"]
