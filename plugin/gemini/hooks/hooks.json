{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "mnema-opening",
            "type": "command",
            "command": "node \"${extensionPath}/hooks/mnema.mjs\" open",
            "timeout": 15000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "^(write_file|replace)$",
        "hooks": [
          {
            "name": "mnema-gate",
            "type": "command",
            "command": "node \"${extensionPath}/hooks/mnema.mjs\" gate",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
