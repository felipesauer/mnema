{
  "description": "A stable id for each hook of hooks.json, which the host refuses to carry a key of its own for. Each entry points at one hook by event, group and position, and names what it runs; the-hooks-have-stable-ids reads both files and is red if a hook has no id, an id has no hook, or an id now points at a different hook.",
  "hooks": {
    "session-start": {
      "event": "SessionStart",
      "group": 0,
      "index": 0,
      "runs": "hooks/session-start.mjs"
    },
    "session-recall": {
      "event": "SessionStart",
      "group": 0,
      "index": 1,
      "runs": "hooks/session-recall.mjs"
    },
    "session-compacted": {
      "event": "SessionStart",
      "group": 1,
      "index": 0,
      "runs": "hooks/session-compacted.mjs"
    },
    "session-tally-stop": {
      "event": "Stop",
      "group": 0,
      "index": 0,
      "runs": "hooks/session-tally.mjs"
    },
    "session-corrections": {
      "event": "Stop",
      "group": 0,
      "index": 1,
      "runs": "hooks/session-corrections.mjs"
    },
    "rules-before-an-edit": {
      "event": "PreToolUse",
      "group": 0,
      "index": 0,
      "runs": "rules_before_an_edit"
    },
    "edit-refuses-a-write": {
      "event": "PreToolUse",
      "group": 1,
      "index": 0,
      "runs": "hooks/edit-refuses-a-write.mjs"
    },
    "edit-asks-a-person": {
      "event": "PreToolUse",
      "group": 2,
      "index": 0,
      "runs": "hooks/edit-asks-a-person.mjs"
    },
    "choice-settled": {
      "event": "PostToolUse",
      "group": 0,
      "index": 0,
      "runs": "hooks/choice-settled.mjs"
    },
    "after-a-write": {
      "event": "PostToolUse",
      "group": 1,
      "index": 0,
      "runs": "hooks/after-a-write.mjs"
    },
    "subagent-start": {
      "event": "SubagentStart",
      "group": 0,
      "index": 0,
      "runs": "hooks/subagent-start.mjs"
    },
    "subagent-stop": {
      "event": "SubagentStop",
      "group": 0,
      "index": 0,
      "runs": "hooks/subagent-stop.mjs"
    }
  }
}
