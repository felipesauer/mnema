# A floor pnpm does not enforce is prose. Without this, `engines.node` is advisory: pnpm
# installs on a runtime below the floor and the failure arrives later, in a tree the adopter
# has already built. The floor itself comes from `@sigstore/verify`, which declares
# `^24.15.0`, and from `node:sqlite`, the cache's driver, which is a release candidate from
# 24.15.0.
engine-strict=true
