{
  "name": "mnema-server-only",
  "version": "0.1.5",
  "description": "Connects the mnema MCP server so the agent can record its own work, and runs no hook: nothing is handed to a session as it opens or before a write.",
  "author": {
    "name": "Felipe Sauer",
    "url": "https://github.com/felipesauer"
  },
  "homepage": "https://mnema.work/",
  "repository": "https://github.com/mnema-work/mnema",
  "license": "Apache-2.0",
  "keywords": ["audit-trail", "append-only", "accountability", "adr", "local-first"],
  "mcpServers": {
    "mnema": {
      "command": "mnema",
      "args": ["mcp"],
      "cwd": ".",
      "env": {
        "MNEMA_AGENT_KEY": "copilot"
      }
    }
  }
}
