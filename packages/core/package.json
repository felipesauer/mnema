{
  "name": "@mnema/core",
  "version": "0.1.5",
  "description": "The mnema work domain: the gate over the SHAPE of a change, projections, identity, and queries. Depends on @mnema/chain.",
  "keywords": [
    "ai-agents",
    "adr",
    "decision-records",
    "audit-trail"
  ],
  "author": "Felipe Sauer (https://github.com/felipesauer)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./write": {
      "types": "./dist/write.d.ts",
      "default": "./dist/write.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map",
    "NOTICE"
  ],
  "homepage": "https://mnema.work/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnema-work/mnema.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mnema-work/mnema/issues"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@mnema/chain": "workspace:*"
  }
}
