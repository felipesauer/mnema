{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stack.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "author",
    "license"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "brings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "event",
          "file",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^hooks/.+"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "const": false
          }
        }
      }
    }
  }
}
