{
  "name": "@mnema/chain",
  "version": "0.1.0",
  "description": "The mnema proof engine: typed event catalog, per-tail hash chain, Ed25519 checkpoints, and verification. Zero runtime dependencies.",
  "author": "Felipe Sauer (https://github.com/felipesauer)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./one-line": {
      "types": "./dist/one-line.d.ts",
      "default": "./dist/one-line.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "verifier/",
    "!verifier/**/__pycache__",
    "FORMAT.md",
    "canonical-vectors.json",
    "event-schema.json"
  ],
  "homepage": "https://github.com/felipesauer/mnema",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipesauer/mnema.git"
  },
  "bugs": {
    "url": "https://github.com/felipesauer/mnema/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
