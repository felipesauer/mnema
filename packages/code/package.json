{
  "name": "@mnema/code",
  "version": "0.1.0-beta",
  "description": "Your decisions, handed to your agents' sessions and held at the edits they govern — append-only and signed in the repository, and checkable by anyone.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "audit-trail",
    "tamper-evident",
    "append-only",
    "accountability",
    "local-first"
  ],
  "author": "Felipe Sauer (https://github.com/felipesauer)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mnema": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "default": "./dist/library.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "NOTICE"
  ],
  "homepage": "https://github.com/felipesauer/mnema",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipesauer/mnema.git"
  },
  "bugs": {
    "url": "https://github.com/felipesauer/mnema/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@mnema/chain": "workspace:*",
    "@mnema/context": "workspace:*",
    "@mnema/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "0.28.1"
  }
}
