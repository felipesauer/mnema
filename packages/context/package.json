{
  "name": "@mnema/context",
  "version": "0.1.0-beta",
  "description": "The mnema context layer: read-only derivations that turn the proven record into the context that guides an agent. Depends on @mnema/core.",
  "author": "Felipe Sauer (https://github.com/felipesauer)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "NOTICE"
  ],
  "homepage": "https://github.com/felipesauer/mnema",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipesauer/mnema.git"
  },
  "bugs": {
    "url": "https://github.com/felipesauer/mnema/issues"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@mnema/core": "workspace:*"
  },
  "devDependencies": {
    "@mnema/chain": "workspace:*"
  }
}
