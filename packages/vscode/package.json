{
  "name": "@mnema/vscode",
  "displayName": "mnema",
  "publisher": "mnema",
  "version": "0.1.4",
  "private": true,
  "description": "Shows the rules in force over the open file, the decisions waiting for a judgment and the stacks adopted for the project, as the mnema command line reports them.",
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai-agents",
    "coding-agents",
    "adr",
    "decision-records",
    "audit-trail",
    "accountability",
    "vscode",
    "decisions"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "preview": true,
  "author": "Felipe Sauer (https://github.com/felipesauer)",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/felipesauer/mnema",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipesauer/mnema.git"
  },
  "bugs": {
    "url": "https://github.com/felipesauer/mnema/issues"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "vscode": "^1.90.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "workspaceContains:.mnema"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "mnema",
      "properties": {
        "mnema.command": {
          "type": "string",
          "default": "mnema",
          "scope": "machine",
          "markdownDescription": "The `mnema` executable the extension runs. It is started directly, with an argument array, never through a shell. Set it in your user settings: a repository's own settings cannot change it."
        },
        "mnema.stackIndex": {
          "type": "string",
          "default": "stack-index",
          "scope": "machine",
          "markdownDescription": "The folder holding the index of stacks (`index.json`), relative to the workspace folder. It is read by `mnema stack index`."
        },
        "mnema.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Show the mnema item in the status bar. Set it in your user settings: a repository's own settings cannot hide it, because it says when `mnema verify` fails."
        }
      }
    },
    "colors": [
      {
        "id": "mnema.recordFolder",
        "description": "The badge and the name of the .mnema folder in the Explorer: the mnema accent.",
        "defaults": {
          "dark": "#c4a0f5",
          "light": "#997dbf",
          "highContrast": "#c4a0f5",
          "highContrastLight": "#5b3d99"
        }
      }
    ],
    "icons": {
      "mnema-m": {
        "description": "The mnema mark",
        "default": {
          "fontPath": "media/mnema-icons.ttf",
          "fontCharacter": "\\E000"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mnema",
          "title": "mnema",
          "icon": "media/mnema.svg"
        }
      ]
    },
    "views": {
      "mnema": [
        {
          "id": "mnema.proposed",
          "name": "Awaiting Judgment",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "mnema.stacks",
          "name": "Stacks",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mnema.proposed",
        "contents": "This folder holds no .mnema record, so there is nothing to list. Run mnema init in a [terminal](command:workbench.action.terminal.new) here to start one; [what a first record looks like](https://github.com/felipesauer/mnema/blob/main/docs/first-record.md).",
        "when": "!mnema.hasRecord"
      },
      {
        "view": "mnema.proposed",
        "contents": "The mnema command could not be used, so nothing is listed, which is not the same as nothing pending. Install it with npm i -g @mnema/code ([how](https://github.com/felipesauer/mnema/blob/main/docs/install.md)), or point the extension at the executable with the mnema.command setting ([open it](command:workbench.action.openSettings?%5B%22mnema.command%22%5D)); then [refresh](command:mnema.refresh).",
        "when": "mnema.hasRecord && mnema.cliMissing"
      },
      {
        "view": "mnema.proposed",
        "contents": "Nothing awaits a judgment, as mnema reads it. [Refresh](command:mnema.refresh) reads it again.",
        "when": "mnema.hasRecord && !mnema.cliMissing && mnema.proposedRead"
      },
      {
        "view": "mnema.proposed",
        "contents": "mnema has not listed the decisions awaiting a judgment. If it could not run, the status bar says what it read; [refresh](command:mnema.refresh) or [set the mnema command](command:workbench.action.openSettings?%5B%22mnema.command%22%5D).",
        "when": "mnema.hasRecord && !mnema.cliMissing && !mnema.proposedRead"
      },
      {
        "view": "mnema.stacks",
        "contents": "This folder holds no .mnema record, so no stack is adopted. Run mnema init in a [terminal](command:workbench.action.terminal.new) here to start one; [what a first record looks like](https://github.com/felipesauer/mnema/blob/main/docs/first-record.md).",
        "when": "!mnema.hasRecord"
      },
      {
        "view": "mnema.stacks",
        "contents": "The mnema command could not be used, so nothing is listed, which is not the same as nothing pending. Install it with npm i -g @mnema/code ([how](https://github.com/felipesauer/mnema/blob/main/docs/install.md)), or point the extension at the executable with the mnema.command setting ([open it](command:workbench.action.openSettings?%5B%22mnema.command%22%5D)); then [refresh](command:mnema.refresh).",
        "when": "mnema.hasRecord && mnema.cliMissing"
      },
      {
        "view": "mnema.stacks",
        "contents": "No stack is adopted for this project, as mnema stack list reads it. [Add one](command:mnema.stacks.add) from a folder, an archive or a git address, or [from the index](command:mnema.stacks.addFromIndex).",
        "when": "mnema.hasRecord && !mnema.cliMissing && mnema.stacksRead"
      },
      {
        "view": "mnema.stacks",
        "contents": "mnema has not listed the stacks. If it could not run, the status bar says what it read; [refresh](command:mnema.refresh) or [set the mnema command](command:workbench.action.openSettings?%5B%22mnema.command%22%5D).",
        "when": "mnema.hasRecord && !mnema.cliMissing && !mnema.stacksRead"
      }
    ],
    "commands": [
      {
        "command": "mnema.accept",
        "title": "Accept Decision",
        "category": "mnema",
        "icon": "$(check)"
      },
      {
        "command": "mnema.reject",
        "title": "Reject Decision",
        "category": "mnema",
        "icon": "$(close)"
      },
      {
        "command": "mnema.openDecision",
        "title": "Open Decision",
        "category": "mnema",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mnema.whatToDo",
        "title": "What To Do",
        "category": "mnema",
        "icon": "$(list-unordered)"
      },
      {
        "command": "mnema.refresh",
        "title": "Refresh",
        "category": "mnema",
        "icon": "$(refresh)"
      },
      {
        "command": "mnema.showRules",
        "title": "Show File Rules",
        "category": "mnema",
        "icon": "$(law)"
      },
      {
        "command": "mnema.why",
        "title": "Why Is This File Like This?",
        "category": "mnema",
        "icon": "$(history)"
      },
      {
        "command": "mnema.stacks.add",
        "title": "Add Stack",
        "category": "mnema",
        "icon": "$(add)"
      },
      {
        "command": "mnema.stacks.addFromIndex",
        "title": "Add from Index",
        "category": "mnema",
        "icon": "$(library)"
      },
      {
        "command": "mnema.stacks.show",
        "title": "Show Stack",
        "category": "mnema",
        "icon": "$(eye)"
      },
      {
        "command": "mnema.stacks.diff",
        "title": "Compare Stack",
        "category": "mnema",
        "icon": "$(diff)"
      },
      {
        "command": "mnema.stacks.check",
        "title": "Check Stack",
        "category": "mnema",
        "icon": "$(checklist)"
      },
      {
        "command": "mnema.stacks.remove",
        "title": "Remove Stack",
        "category": "mnema",
        "icon": "$(trash)"
      },
      {
        "command": "mnema.stacks.export",
        "title": "Export Stack",
        "category": "mnema",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "mnema.accept",
          "when": "view == mnema.proposed",
          "group": "inline@1"
        },
        {
          "command": "mnema.reject",
          "when": "view == mnema.proposed",
          "group": "inline@2"
        },
        {
          "command": "mnema.accept",
          "when": "view == mnema.proposed",
          "group": "1_accept@1"
        },
        {
          "command": "mnema.reject",
          "when": "view == mnema.proposed",
          "group": "2_reject@1"
        },
        {
          "command": "mnema.stacks.show",
          "when": "view == mnema.stacks",
          "group": "inline@1"
        },
        {
          "command": "mnema.stacks.diff",
          "when": "view == mnema.stacks",
          "group": "inline@2"
        },
        {
          "command": "mnema.stacks.check",
          "when": "view == mnema.stacks",
          "group": "inline@3"
        },
        {
          "command": "mnema.stacks.show",
          "when": "view == mnema.stacks",
          "group": "1_inspect@1"
        },
        {
          "command": "mnema.stacks.diff",
          "when": "view == mnema.stacks",
          "group": "1_inspect@2"
        },
        {
          "command": "mnema.stacks.check",
          "when": "view == mnema.stacks",
          "group": "1_inspect@3"
        },
        {
          "command": "mnema.stacks.export",
          "when": "view == mnema.stacks",
          "group": "2_export@1"
        },
        {
          "command": "mnema.stacks.remove",
          "when": "view == mnema.stacks",
          "group": "9_other@1"
        }
      ],
      "view/title": [
        {
          "command": "mnema.refresh",
          "when": "view == mnema.proposed",
          "group": "navigation@1"
        },
        {
          "command": "mnema.whatToDo",
          "when": "view == mnema.proposed",
          "group": "1_more@1"
        },
        {
          "command": "mnema.stacks.add",
          "when": "view == mnema.stacks",
          "group": "navigation@1"
        },
        {
          "command": "mnema.refresh",
          "when": "view == mnema.stacks",
          "group": "navigation@2"
        },
        {
          "command": "mnema.stacks.addFromIndex",
          "when": "view == mnema.stacks",
          "group": "1_add@1"
        }
      ],
      "editor/title": [
        {
          "command": "mnema.accept",
          "when": "resourceScheme == mnema-decision && mnema.activeDecisionProposed",
          "group": "navigation@1"
        },
        {
          "command": "mnema.reject",
          "when": "resourceScheme == mnema-decision && mnema.activeDecisionProposed",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "mnema.accept",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.reject",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.openDecision",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.whatToDo",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.refresh",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.showRules",
          "when": "workspaceFolderCount > 0 && resourceScheme == file"
        },
        {
          "command": "mnema.why",
          "when": "workspaceFolderCount > 0 && resourceScheme == file"
        },
        {
          "command": "mnema.stacks.add",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.stacks.addFromIndex",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.stacks.show",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.stacks.diff",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.stacks.check",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.stacks.remove",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mnema.stacks.export",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "explorer/context": [
        {
          "command": "mnema.why",
          "when": "resourceScheme == file && mnema.hasRecord",
          "group": "mnema@1"
        }
      ],
      "editor/context": [
        {
          "command": "mnema.why",
          "when": "resourceScheme == file && mnema.hasRecord",
          "group": "mnema@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "mnema.start",
        "title": "Get started with mnema",
        "description": "Three steps: make the command available, start a record, run mnema verify.",
        "steps": [
          {
            "id": "mnema.start.command",
            "title": "Make the mnema command available",
            "description": "The extension runs the mnema command line and nothing else. Install it with npm i -g @mnema/code, or set the executable the extension starts.\n[Open the mnema.command setting](command:workbench.action.openSettings?%5B%22mnema.command%22%5D)",
            "media": {
              "markdown": "media/walkthrough/command.md"
            }
          },
          {
            "id": "mnema.start.init",
            "title": "Start a record in this project",
            "description": "Run mnema init in a terminal at the project root. It creates the .mnema folder where the record is kept. Then run mnema: Refresh, which starts the extension in a window that opened without one.\n[Open a terminal](command:workbench.action.terminal.new)\n[Refresh mnema](command:mnema.refresh)",
            "media": {
              "markdown": "media/walkthrough/init.md"
            },
            "completionEvents": [
              "onContext:mnema.hasRecord"
            ]
          },
          {
            "id": "mnema.start.verify",
            "title": "Run mnema verify and read what it prints",
            "description": "Run mnema verify in the terminal. It prints the level it reached and what that level covers. The status bar shows that level and nothing more.\n[Open a terminal](command:workbench.action.terminal.new)\n[Refresh the status bar](command:mnema.refresh)",
            "media": {
              "markdown": "media/walkthrough/verify.md"
            }
          }
        ]
      }
    ]
  },
  "files": [
    "extension.cjs",
    "media",
    "NOTICE"
  ],
  "scripts": {
    "package": "node build/package-vsix.mjs",
    "install-check": "node build/install-the-vsix.mjs"
  },
  "devDependencies": {
    "@mnema/chain": "workspace:*",
    "@mnema/context": "workspace:*",
    "@mnema/core": "workspace:*",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2"
  }
}
